generator client { provider = "prisma-client-js" }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishState { DRAFT PUBLISHED }
enum OrderStatus { PENDING PAID FULFILLED SHIPPED DELIVERED CANCELED }

model Product {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  shortDescription  String
  fullDescription   String
  priceAmd          Int
  cartonQuantity    String
  mainImage         String
  galleryImages     String[]
  category          String
  tags              String[]
  featured          Boolean  @default(false)
  inStock           Boolean  @default(true)
  ingredients       String
  nutritionAllergens String
  care              String
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BlogPost {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  excerpt        String
  coverImage     String
  body           String
  categories     String[]
  tags           String[]
  seoTitle       String
  seoDescription String
  state          PublishState @default(DRAFT)
  publishDate    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
}

model HomepageSetting {
  id                 String   @id @default(cuid())
  featuredProductIds String[]
}

model WholesaleLead {
  id              String   @id @default(cuid())
  accountName     String
  accountEmail    String
  companyName     String
  taxId           String?
  shippingAddress String
  agreedToTerms   Boolean
  createdAt       DateTime @default(now())
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  comment   String
  createdAt DateTime @default(now())
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Cart { id String @id @default(cuid()) items CartItem[] }
model CartItem { id String @id @default(cuid()) cartId String productId String quantity Int cart Cart @relation(fields: [cartId], references:[id]) }
model CheckoutSession { id String @id @default(cuid()) cartId String status String paymentProvider String? }
model ShippingMethod { id String @id @default(cuid()) name String priceAmd Int }
model Address { id String @id @default(cuid()) fullName String line1 String city String postalCode String country String phone String }
model Order { id String @id @default(cuid()) status OrderStatus @default(PENDING) totalAmd Int }
